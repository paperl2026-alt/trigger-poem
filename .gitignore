# 能重新生成的东西不进存档
node_modules/
dist/
release/
art/_shots/
art/jiggle_test/
__pycache__/
*.log
tools/models/
dist-portable/
trigger-poem-portable.zip
# Codex job files: generated from tools/rounds/job_specsNN.py by tools/make_jobs.py
art/jobs/
# the dev build's save files next to the project (electron/store.cjs)
saves/
# downloaded sound-effect sources (tools/rounds/sfx_import.py turns them into the content pack)
art/raw/sfx_dl/
# the voice-synthesis engine (official AivisSpeech zip) and ffmpeg, unpacked here by hand (tools/voice_aivis.py)
tools/aivis/
tools/ffmpeg/
# downloaded KTX tools (KTX2 was dropped: user 2026-10-18)
tools/ktx/
art/raw/bgm/*.wav
art/raw/bgm/*.mp3
art/raw/sfx_ai/**/*.wav
art/raw/bgm_ai/**/*.wav
# ACE-Step's own cache when it runs from the project folder (tools/bgm_ace.py)
.cache/
# the sheets the sound / music pickers draw (tools/sfx_look.py, sfx_pick.py, bgm_pick.py): made again on every run
art/raw/sfx_ai/_look/*.png
art/raw/bgm_ai/_look/*.png
art/raw/bgm_ai/_raw/
# the cut-out check's overview sheets (tools/cutout_check.py)
art/raw/_cutout/
